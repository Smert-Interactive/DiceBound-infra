# Docker images
BACKEND_IMAGE=ghcr.io/smert-interactive/dicebound-backend:sha-REPLACE_WITH_COMMIT_SHA
FRONTEND_IMAGE=ghcr.io/smert-interactive/dicebound-frontend:sha-REPLACE_WITH_COMMIT_SHA

# Existing PostgreSQL
DATABASE_URL=postgresql://USERNAME:PASSWORD@DB_HOST:5432/dicebound

# Frontend origin
ALLOWED_ORIGINS=https://dicebound.example.com